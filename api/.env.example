APP_NAME=elegio-api
APP_ENV=development
DEBUG=true

DATABASE_URL=mysql+aiomysql://elegio_user:elegio_password@localhost:3306/elegio
DATABASE_URL_SYNC=mysql+pymysql://elegio_user:elegio_password@localhost:3306/elegio

JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=1440

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
EAGER_LOAD_SEARCH_ON_STARTUP=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGIN_REGEX=https?://(localhost|127\.0\.0\.1):\d+

GEMINI_API_KEY=your-gemini-api-key-here